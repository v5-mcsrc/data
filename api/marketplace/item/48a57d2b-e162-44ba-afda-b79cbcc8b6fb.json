res & experiences!\ndiscord.gg/PeFscBw"}],"tags":["98435729-6a2b-4e2c-bf78-4cffa7cfae55","6f68a6a5-8e69-486c-a2fb-2164fad834bc","tag.add_on","tag.chest","tag.loot","tag.secret_base","tag.stealth","tag.friends","3P","addon","genre.survival","48a57d2b-e162-44ba-afda-b79cbcc8b6fb"],"contentSize":855684.0,"downloadUrls":["https://content1.prod.catalog.playfab.com/pf-namespace-b63a0803d3653643/04e1f6df-dd74-4737-a659-ba23a73bd93f/primary.zip"],"downloadVariants":[{"label":"Standard","tags":[],"urls":["https://content1.prod.catalog.playfab.com/pf-namespace-b63a0803d3653643/04e1f6df-dd74-4737-a659-ba23a73bd93f/primary.zip"]}],"cdnUrls":["https://content1.prod.catalog.playfab.com/pf-namespace-b63a0803d3653643/04e1f6df-dd74-4737-a659-ba23a73bd93f/primary.zip"],"legacyUrls":[],"downloadable":true}}