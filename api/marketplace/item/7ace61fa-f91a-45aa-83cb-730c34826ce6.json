ur chosen dye to create paint. Coat a brush in the paint, then use it on any wall face. Clean the brush in water before changing colors. Use a Scraper to remove paint."}],"tags":["7ace61fa-f91a-45aa-83cb-730c34826ce6","0742b254-d060-404c-bba7-cb600ce422a6","8b0302eb-9a6f-4219-bcef-3a4e5e3e2499","tag.base_building","tag.build","tag.building","tag.city_builder","tag.colorful","tag.colors","tag.decorate","tag.friends","video_trailer","3P","addon","genre.creative","tag.vibrantvisuals","vvenhanced"],"contentSize":8304784.0,"downloadUrls":["https://content1.prod.catalog.playfab.com/pf-namespace-b63a0803d3653643/9550f32e-9c7d-495d-bcae-900bccf74da8/primary.zip"],"downloadVariants":[{"label":"Standard","tags":[],"urls":["https://content1.prod.catalog.playfab.com/pf-namespace-b63a0803d3653643/9550f32e-9c7d-495d-bcae-900bccf74da8/primary.zip"]}],"cdnUrls":["https://content1.prod.catalog.playfab.com/pf-namespace-b63a0803d3653643/9550f32e-9c7d-495d-bcae-900bccf74da8/primary.zip"],"legacyUrls":[],"downloadable":true}}